#!/usr/bin/env bash
# SessionStart hook for the Catalyst plugin.
# Injects the using-catalyst introduction so every session knows the family's
# process skills exist and how they route.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

intro_content=$(cat "${PLUGIN_ROOT}/skills/using-catalyst/SKILL.md" 2>&1 || echo "Error reading using-catalyst skill")

# Dispatch routing slice — rendered from the SAME table the PreToolUse gate
# reads (hooks/routing-table.toml), so no second copy of the rules exists.
# If rendering fails (no python3), inject a loud warning: the gate is
# fail-closed and will deny dispatches until repaired.
routing_slice=$(python3 "${SCRIPT_DIR}/dispatch-gate.py" --render-slice 2>/dev/null) \
  || routing_slice="!! DISPATCH ROUTING SLICE UNAVAILABLE (python3 or hooks/routing-table.toml broken) — the dispatch gate is fail-closed: Task/Agent dispatches and envoy/proxy calls will be DENIED until repaired (catalyst:install)."

# Escape for JSON embedding via bash parameter substitution (single C-level
# passes — far faster than a character loop).
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Свежесть УСТАНОВЛЕННОЙ копии против её источника. Молчит, когда всё
# сошлось, поэтому шума в контексте нет.
#
# CONSTRAINT: stderr прибора НЕ гасить и его код НЕ терять. Прибор отдаёт 2
# «не могу мерить» и пишет причину в stderr; форма `$(... 2>/dev/null) || x=""`
# превращала оба в пустую строку, и отказ прибора становился неотличим от
# «всё сошлось» -- то есть дверь молчала ровно в том случае, ради которого
# заведена (ПУСТО ≠ НОЛЬ). Громкая строка в контекст -- та же дисциплина, что
# у среза маршрутизации выше.
freshness_errfile=$(mktemp "${TMPDIR:-/tmp}/catalyst-freshness.XXXXXX")
freshness_rc=0
freshness=$(python3 "${SCRIPT_DIR}/plugin-freshness.py" 2>"$freshness_errfile") || freshness_rc=$?
freshness_err=$(cat "$freshness_errfile")
rm -f "$freshness_errfile"
if [ "$freshness_rc" -ne 0 ]; then
  freshness="!! PLUGIN FRESHNESS UNMEASURED (код ${freshness_rc}): ${freshness_err:-прибор не назвал причины}. Установленная копия могла отстать от репозитория, и этого сейчас никто не знает -- мерить вручную: python3 \"${SCRIPT_DIR}/plugin-freshness.py\""
fi

intro_escaped=$(escape_for_json "$intro_content")
slice_escaped=$(escape_for_json "$routing_slice")
freshness_escaped=""
if [ -n "$freshness" ]; then
  freshness_escaped="\n\n$(escape_for_json "$freshness")"
fi
session_context="<CATALYST>\nYou have Catalyst - a disciplined layer for multi-step software work. Below is the 'using-catalyst' introduction: how its process skills route. For any specific skill, use the 'Skill' tool.\n\n${intro_escaped}\n\n${slice_escaped}${freshness_escaped}\n</CATALYST>"

# Emit only the field the current platform consumes.
# Cursor: additional_context (snake_case). Claude Code: nested
# hookSpecificOutput.additionalContext. Others (Copilot CLI, SDK): top-level
# additionalContext. printf avoids the bash 5.3+ heredoc hang.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
